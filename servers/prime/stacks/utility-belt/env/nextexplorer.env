# https://explorer.nxz.ai/configuration/environment.html

NODE_ENV=production
PUBLIC_URL=https://explorer.${DOMAIN}
USER_VOLUMES=true

# OIDC
AUTH_MODE=oidc
OIDC_ENABLED=true
OIDC_ISSUER=https://auth2.${DOMAIN}
OIDC_CLIENT_ID=${NEXTEXPLORER_OIDC_CLIENT_ID}
OIDC_CLIENT_SECRET=${NEXTEXPLORER_OIDC_CLIENT_SECRET}
OIDC_ADMIN_GROUPS=${NEXTEXPLORER_OIDC_ADMIN_GROUPS}
OIDC_SCOPES=openid profile email
OIDC_AUTO_CREATE_USERS=true
OIDC_REQUIRE_EMAIL_VERIFIED=true