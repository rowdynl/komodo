JWT_SECRET=${BYTESTASH_JWT_SECRET}
TOKEN_EXPIRY=48H
ALLOW_NEW_ACCOUNTS=TRUE
DISABLE_INTERNAL_ACCOUNTS=TRUE
OIDC_ENABLED=TRUE
OIDC_DISPLAY_NAME=Authentik
OIDC_ISSUER_URL=https://auth.${DOMAIN}/application/o/bytestash/
OIDC_CLIENT_ID=${BYTESTASH_OIDC_CLIENTID}
OIDC_CLIENT_SECRET=${BYTESTASH_OIDC_CLIENTSECRET}