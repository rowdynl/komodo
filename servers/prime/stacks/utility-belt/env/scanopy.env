SCANOPY_LOG_LEVEL=info
SCANOPY_DATABASE_URL=postgresql://${SCANOPY_PG_USER}:${SCANOPY_PG_PASSWORD}@postgresql-scanopy.backend:5432/${SCANOPY_PG_DB}
SCANOPY_WEB_EXTERNAL_PATH=/app/static
SCANOPY_PUBLIC_URL=https://scanopy.${DOMAIN}
SCANOPY_INTEGRATED_DAEMON_URL=http://${GLOBAL_SERVER_URL}:60073
SCANOPY_SERVER_URL=https://scanopy.${DOMAIN}
SCANOPY_NETWORK_ID=${SCANOPY_NETWORK_ID}
SCANOPY_DAEMON_API_KEY=${SCANOPY_DAEMON_API_KEY}
SCANOPY_USER_ID=${SCANOPY_USER_ID}
SCANOPY_NAME=scanopy-daemon-thoes
SCANOPY_MODE=daemon_poll