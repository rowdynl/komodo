TUDUDI_SESSION_SECRET=${TUDUDI_SESSION_SECRET}
TUDUDI_ALLOWED_ORIGINS=https://tududi.${DOMAIN}
TUDUDI_TRUST_PROXY=true
TUDUDI_UPLOAD_PATH=/app/backend/uploads

# OIDC Configuration
PASSWORD_AUTH_ENABLED=false
OIDC_ENABLED=true
OIDC_PROVIDER_NAME=Authentik
OIDC_PROVIDER_SLUG=authentik
OIDC_ISSUER_URL=https://auth.${DOMAIN}/application/o/tududi/
OIDC_CLIENT_ID=${TUDUDI_OIDC_CLIENT_ID}
OIDC_CLIENT_SECRET=${TUDUDI_OIDC_CLIENT_SECRET}
OIDC_SCOPE="openid profile email"
OIDC_AUTO_PROVISION=true
TUDUDI_BASE_URL=https://tududi.${DOMAIN}