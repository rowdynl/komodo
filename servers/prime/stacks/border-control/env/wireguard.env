WG_ALLOWED_IPS=${WIREGUARD_ALLOWED_IPS}
WG_HOST=${WIREGUARD_HOST}

OAUTH_PROVIDERS=oidc
OAUTH_AUTO_LAUNCH=true
OAUTH_AUTO_REGISTER=true
DISABLE_PASSWORD_AUTH=true
OAUTH_OIDC_SERVER=https://id.${DOMAIN}
OAUTH_OIDC_CLIENT_ID=${WIREGUARD_OIDC_CLIENT_ID}
OAUTH_OIDC_CLIENT_SECRET=${WIREGUARD_OIDC_CLIENT_SECRET}
OAUTH_OIDC_NAME='Pocket ID'