WG_PORTAL_AUTH_HIDE_LOGIN_FORM=true
WG_PORTAL_CORE_CREATE_DEFAULT_PEER_ON_USER_CREATION=true
WG_PORTAL_AUTH_WEBAUTHN_ENABLED=false

WG_PORTAL_MAIL_HOST=${GLOBAL_SMTP2GO_EMAIL}
WG_PORTAL_MAIL_PORT=${GLOBAL_SMTP2GO_PORT}
WG_PORTAL_MAIL_ENCRYPTION=TLS
WG_PORTAL_MAIL_USERNAME=${GLOBAL_SMTP2GO_USERNAME}
WG_PORTAL_MAIL_PASSWORD=${GLOBAL_SMTP2GO_PASSWORD}
WG_PORTAL_MAIL_FROM=Wireguard (${DOMAIN}) <${GLOBAL_SMTP2GO_EMAIL}>