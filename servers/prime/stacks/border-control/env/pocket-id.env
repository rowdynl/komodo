APP_URL=${OIDC_BASE_URL}
ALLOW_USER_SIGNUPS=false

DB_CONNECTION_STRING=postgres://${POCKET_ID_PG_USER}:${POCKET_ID_PG_PASSWORD}@postgresql-pocket-id.backend:5432/${POCKET_ID_PG_DB}

