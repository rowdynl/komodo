# GLOBAL VARIABLES
USER_DBBACKUP=${PUID}
GROUP_DBBACKUP=${PGID}
TIMEZONE=${TZ}
DEFAULT_BACKUP_BEGIN=0200
BACKUP_JOB_CONCURRENCY=2
ENABLE_NOTIFICATIONS=TRUE
CONTAINER_ENABLE_MONITORING=FALSE
NOTIFICATION_TYPE=CUSTOM
NOTIFICATION_CUSTOM_SCRIPT=/assets/custom-scripts/pushover.notification.sh
#DEFAULT_PRE_SCRIPT=/assets/custom-scripts/pushover.pre.sh
#DEFAULT_POST_SCRIPT=/assets/custom-scripts/pushover.post.sh

# MARIADB - All
DB01_TYPE=mariadb
DB01_HOST=mariadb.backend
DB01_USER=${DATABASE_BACKUP_MARIADB_USER}
DB01_PASS=${DATABASE_BACKUP_MARIADB_PASSWORD}
DB01_NAME=ALL

# INFLUXDB - speedtest-tracker
DB02_TYPE=influxdb
DB02_HOST=influxdb.backend
DB02_USER=${INFLUXDB_USER}
DB02_PASS=${INFLUXDB_PASSWORD}
DB02_INFLUX_VERSION=2
DB02_NAME=ALL

# POSTGRESQL - pocket-id
DB03_TYPE=pgsql
DB03_HOST=postgresql-pocket-id.backend
DB03_DB=${POCKET_ID_PG_DB}
DB03_PASS=${POCKET_ID_PASSWORD}
DB03_USER=${POCKET_ID_USER}
DB03_NAME=ALL

# MONGODB - komodo
DB04_TYPE=mongo
DB04_HOST=komodo-mongodb.backend
DB04_USER=${KOMODO_DB_USER}
DB04_PASS=${KOMODO_DB_PASSWORD}
DB04_NAME=ALL

# POSTGRESQL - odoo
DB05_TYPE=pgsql
DB05_HOST=postgresql-odoo.backend
DB05_DB=${ODOO_PG_DB}
DB05_PASS=${ODOO_PG_PASSWORD}
DB05_USER=${ODOO_PG_USER}
DB05_NAME=ALL

# POSTGRESQL - umami
DB06_TYPE=pgsql
DB06_HOST=postgresql-umami.backend
DB06_DB=${UMAMI_PG_DB}
DB06_PASS=${UMAMI_PG_PASSWORD}
DB06_USER=${UMAMI_PG_USER}
DB06_NAME=ALL

# POSTGRESQL - paperless-ngx
DB07_TYPE=pgsql
DB07_HOST=postgresql-paperless.backend
DB07_DB=${PAPERLESS_PG_DB}
DB07_PASS=${PAPERLESS_PG_PASSWORD}
DB07_USER=${PAPERLESS_PG_USER}
DB07_NAME=ALL

# POSTGRESQL - spottarr
DB08_TYPE=pgsql
DB08_HOST=postgresql-spottarr.backend
DB08_DB=${SPOTTARR_PG_DB}
DB08_PASS=${SPOTTARR_PG_PASSWORD}
DB08_USER=${SPOTTARR_PG_USER}
DB08_NAME=ALL

# POSTGRESQL - airtrail
DB09_TYPE=pgsql
DB09_HOST=postgresql-airtrail.backend
DB09_DB=${AIRTRAIL_PG_DB}
DB09_PASS=${AIRTRAIL_PG_PASSWORD}
DB09_USER=${AIRTRAIL_PG_USER}
DB09_NAME=ALL