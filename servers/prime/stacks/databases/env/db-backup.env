# GLOBAL VARIABLES
USER_DBBACKUP=${PUID}
GROUP_DBBACKUP=${PGID}
TIMEZONE=${TZ}
DEFAULT_BACKUP_BEGIN=0200
BACKUP_JOB_CONCURRENCY=2
ENABLE_NOTIFICATIONS=TRUE
NOTIFICATION_TYPE=CUSTOM
NOTIFICATION_CUSTOM_SCRIPT=/assets/scripts/pushover.notification.sh

# MARIADB - All
DB01_TYPE=mariadb
DB01_HOST=mariadb.backend
DB01_USER=${MARIADB_USER}
DB01_PASS=${MARIADB_PASSWORD}
DB01_NAME=ALL

# INFLUXDB - speedtest-tracker
DB02_TYPE=influxdb
DB02_HOST=influxdb.backend
DB02_USER=${INFLUXDB_USER}
DB02_PASS=${INFLUXDB_PASSWORD}
DB02_NAME=ALL

# POSTGRESQL - authentik
DB03_TYPE=pgsql
DB03_HOST=postgresql-authentik.backend
DB03_DB=${AUTHENTIK_PG_DB}
DB03_PASSWORD=${AUTHENTIK_PG_PASSWORD}
DB03_USER=${AUTHENTIK_PG_USER}
DB03_NAME=ALL

# MONGODB - komodo
DB04_TYPE=mongo
DB04_HOST=komodo-mongodb.backend
DB04_USER=${KOMODO_DB_USER}
DB04_PASS=${KOMODO_DB_PASSWORD}
DB04_NAME=ALL

# POSTGRESQL - scanopy
DB05_TYPE=pgsql
DB05_HOST=postgresql-scanopy.backend
DB05_DB=${SCANOPY_PG_DB}
DB05_PASSWORD=${SCANOPY_PG_PASSWORD}
DB05_USER=${SCANOPY_PG_USER}
DB05_NAME=ALL