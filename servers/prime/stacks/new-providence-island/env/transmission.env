OPENVPN_PROVIDER=NORDVPN
OPENVPN_OPTS=
GLOBAL_APPLY_PERMISSIONS=true
TRANSMISSION_HOME=/config/transmission-home
TRANSMISSION_RPC_PORT=9091
TRANSMISSION_DOWNLOAD_DIR=/downloads/transmission/completed
TRANSMISSION_INCOMPLETE_DIR=/downloads/transmission/incomplete
TRANSMISSION_WATCH_DIR=/downloads/transmission/watch
CREATE_TUN_DEVICE=true
TRANSMISSION_RPC_AUTHENTICATION_REQUIRED=true
TRANSMISSION_RPC_USERNAME=${TRANSMISSION_RPC_USERNAME}
TRANSMISSION_RPC_PASSWORD=${TRANSMISSION_RPC_PASSWORD}
NORDVPN_CATEGORY=
NORDVPN_PROTOCOL=tcp
LOCAL_NETWORK=172.16.0.0/12
NORDVPN_COUNTRY=${NORDVPN_COUNTRY}
OPENVPN_CONFIG=${NORDVPN_COUNTRY}
OPENVPN_USERNAME=${OPENVPN_USERNAME}
OPENVPN_PASSWORD=${OPENVPN_PASSWORD}