USENET__HOSTNAME=${USENET_HOST}
USENET__USERNAME=${USENET_USERNAME}
USENET__PASSWORD=${USENET_PASSWORD}
USENET__PORT=${USENET_PORT}
USENET__USETLS=true
USENET__MAXCONNECTIONS=44

SPOTNET__RETRIEVEAFTER=${SPOTTARR_RETRIEVEAFTER}
SPOTNET__IMPORTBATCHSIZE=10000
SPOTNET__RETENTIONDAYS=${SPOTTARR_RETENTION}
SPOTNET__IMPORTADULTCONTENT=false

TZ=${TZ}

DATABASE__PROVIDER=Postgres
DATABASE__CONNECTIONSTRING=Host=postgresql-spottarr.backend;Database=${SPOTTARR_PG_DB};Username=${SPOTTARR_PG_USER};Password=${SPOTTARR_PG_PASSWORD}