ORIGIN=https://airtrail.tcit.nl

DB_URL=postgres://${AIRTRAIL_PG_USER}:${AIRTRAIL_PG_PASSWORD}@postgresql-airtrail.backend:5432/${AIRTRAIL_PG_DB}
DB_PASSWORD=${AIRTRAIL_PG_PASSWORD}
DB_DATABASE_NAME=${AIRTRAIL_PG_DB}
DB_USERNAME=${AIRTRAIL_PG_USER}

UPLOAD_LOCATION=/app/uploads
BODY_SIZE_LIMIT=20M

OAUTH_ENABLED=true
OAUTH_ISSUER_URL=https://id.${DOMAIN}/.well-known/openid-configuration
OAUTH_CLIENT_ID=${AIRTRAIL_OIDC_CLIENTID}
OAUTH_CLIENT_SECRET=${AIRTRAIL_OIDC_CLIENTSECRET}
OAUTH_AUTO_LOGIN=true
OAUTH_HIDE_PASSWORD_FORM=true
OAUTH_SCOPE=openid profile groups

INTEGRATIONS_OPEN_AIP_KEY=${AIRTRAIL_OPEN_AIP_KEY}
INTEGRATIONS_AERO_DATA_BOX_KEY=${AIRTRAIL_AERO_DATA_BOX_KEY}